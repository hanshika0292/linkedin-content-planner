# Supabase project URL, from your Supabase project's API settings
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase anon (publishable) key from the same page. Never put the service_role/secret key here.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Google Gemini API key from Google AI Studio. Optional: AI features show an error without it.
VITE_GEMINI_API_KEY=your-gemini-api-key
# Optional Gemini model name. Leave unset to use the default in src/lib/gemini.ts (gemini-3.8-flash).
# Set it when Google retires that model: https://ai.google.dev/gemini-api/docs/models
# VITE_GEMINI_MODEL=gemini-3.8-flash
